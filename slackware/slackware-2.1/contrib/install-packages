\n\
" 7 75
 installpkg uucp-1.04-info.tgz 1> /dev/null 2> /dev/null
fi
if fgrep '"uucp-1.04"' /tmp/return 1> /dev/null 2> /dev/null ; then
 dialog --title "Installing package uucp-1.04 to your hard drive" --infobox \
"Taylor UUCP 1.04\n\
\n\
This is a well tested version of UUCP that is included as an\n\
alternate version.  (The N series has Taylor UUCP 1.05)\n\
\n\
" 7 75
