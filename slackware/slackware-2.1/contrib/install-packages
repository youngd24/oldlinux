\n\
" 8 75
 installpkg lemacs-X11R5.tgz 1> /dev/null 2> /dev/null
fi
if fgrep '"lemacs-X11R6"' /tmp/return 1> /dev/null 2> /dev/null ; then
 dialog --title "Installing package lemacs-X11R6 to your hard drive" --infobox \
"Lucid Emacs version 19.10\n\
\n\
This is a version of Emacs enhanced to work under X.  This\n\
