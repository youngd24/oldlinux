fi
if fgrep '"dosemu.53p28"' /tmp/return 1> /dev/null 2> /dev/null ; then
 dialog --title "Installing package dosemu.53p28 to your hard drive" --infobox \
"An MSDOS emulator.\n\
\n\
This package allows you to run MS-DOS under Linux by setting up\n\
a virtual machine (DOS box) capable of servicing BIOS calls and\n\
other requirements of DOS while Linux continues to run in \n\
protected mode.  It runs most MS-DOS software that doesn't require\n\
DOS extenders, etc, including Windows 3.0 in real mode.\n\
\n\
Configuration instructions are placed in /usr/doc/dosemu.\n\
\n\
" 12 75
 installpkg dosemu.53p28.tgz 1> /dev/null 2> /dev/null
fi
if fgrep '"gcl"' /tmp/return 1> /dev/null 2> /dev/null ; then
 dialog --title "Installing package gcl to your hard drive" --infobox \
"GNU common lisp 1.0\n\
\n\
" 4 75
 installpkg gcl.tgz 1> /dev/null 2> /dev/null
fi
if fgrep '"gpc-2.5.8"' /tmp/return 1> /dev/null 2> /dev/null ; then
 dialog --title "Installing package gpc-2.5.8 to your hard drive" --infobox \
"GNU Pascal compiler.\n\
\n\
Based on the GCC 2.5.8 compiler.\n\
\n\
" 6 75
