crunch() {
	LIBDIR=$1
	LIBPREFIX=$2
	for f in $LIBDIR/$LIBPREFIX.so.?.*.*
	do
		bname=`basename $f`
#		echo "   - compacting $bname."
		cp $f $LIBDIR/t$bname || exit 1
		rm -f $f
		mv $LIBDIR/t$bname $f
	done
}
#echo "Compacting itcl shared library to decrease disk space utilization..."
crunch usr/lib libitcl;
#echo "itcl shared library compacted."
( cd usr/lib ; rm -rf libitcl.so.3 )
( cd usr/lib ; ln -sf libitcl.so.3.1.0 libitcl.so.3 )
