!     strcpy(tty,"con");
!   else if (dev < 64) {
!     sprintf(tty, "v%02d", dev);
!   } else {
!     if (dev < 128) {
!       sprintf(tty, "s%02d", (dev - 64));
!     } else {
!       tty[0] = 'p';
!       tty[1] = ttgrp[(dev >> 4) & 017];
!       tty[2] = ttsub[dev & 017];
!     }
!   }
!   tty[3] = 0;
! }
  
  int tty_to_dev(char *tty)
--- 36,62 ----
