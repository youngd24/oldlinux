 	 * Do not add anything below this line,
diff -u --recursive --new-file linux-1.1.58/patch.eata linux/patch.eata
--- linux-1.1.58/patch.eata	Wed Dec 31 18:00:00 1969
+++ linux/patch.eata	Wed Oct 26 23:02:02 1994
@@ -0,0 +1,50 @@
