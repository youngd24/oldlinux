+ CFLAGS := $(CFLAGS) -DMODULE
+ endif
+ 
  .c.s:
  	$(CC) $(CFLAGS) -S $<
***************
*** 15,19 ****
  	$(AS) -o $*.o $<
  
! OBJS=	namei.o inode.o file.o dir.o misc.o fat.o mmap.o
  
  msdos.o: $(OBJS)
--- 19,23 ----
  	$(AS) -o $*.o $<
  
! OBJS=	namei.o inode.o file.o dir.o misc.o fat.o
  
  msdos.o: $(OBJS)
