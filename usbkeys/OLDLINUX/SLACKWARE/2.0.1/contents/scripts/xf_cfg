if [ -r var/X11/lib/X11/xinit/xinitrc -a \
     ! -L var/X11/lib/X11/xinit/xinitrc ]; then
#	echo "Moving your old xinitrc to /var/X11/lib/X11/xinit/xinitrc.backup..."
	mv var/X11/lib/X11/xinit/xinitrc var/X11/lib/X11/xinit/xinitrc.backup
fi
if [ ! -r /tmp/SeTcolor -a ! "$COLOR" = "on" ]; then
 echo "  Installing FVWM as your default window manager (start with 'startx')"
 echo "  --> cd /var/X11/lib/X11/xinit"
 echo "  --> ln -sf xinitrc.fvwm xinitrc"
fi
( cd var/X11/lib/X11/xinit ; rm -rf xinitrc )
( cd var/X11/lib/X11/xinit ; ln -sf  xinitrc.fvwm xinitrc )
( cd usr/X11/lib ; rm -rf X11 )
( cd usr/X11/lib ; ln -sf  /var/X11/lib/X11 X11 )
( cd var/X11/lib/X11 ; rm -rf fonts )
( cd var/X11/lib/X11 ; ln -sf  /usr/X11/lib/fonts fonts )
( cd etc ; rm -rf X11 )
( cd etc ; ln -sf  /var/X11/lib/X11 X11 )
