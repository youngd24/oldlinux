( cd usr/lib/texmf/ini ; rm -rf cmplain.base )
( cd usr/lib/texmf/ini ; ln -sf /usr/lib/texmf/ini/cmmf.base cmplain.base )
( cd usr/lib/texmf/ini ; rm -rf cmplain.log )
( cd usr/lib/texmf/ini ; ln -sf /usr/lib/texmf/ini/cmmf.log cmplain.log )
( cd usr/bin ; rm -rf cmmf )
( cd usr/bin ; ln -sf virmf cmmf )
( cd usr/bin ; rm -rf mf )
( cd usr/bin ; ln -sf virmf mf )
( cd usr/man/preformat/cat1 ; rm -rf inimf.1.gz )
( cd usr/man/preformat/cat1 ; ln -sf mf.1.gz inimf.1.gz )
( cd usr/man/preformat/cat1 ; rm -rf virmf.1.gz )
( cd usr/man/preformat/cat1 ; ln -sf mf.1.gz virmf.1.gz )
